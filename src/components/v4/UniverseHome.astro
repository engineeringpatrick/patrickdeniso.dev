---
import VersionPicker from '../VersionPicker.astro';
import { copy, supportedLanguages, type V4Language } from '../../locales/v4';
import PatrickVimEditor from './PatrickVimEditor';
import UniverseExperience from './UniverseExperience';

interface Props {
	initialLanguage?: V4Language;
}

const { initialLanguage } = Astro.props;
const initialSiteCopy = copy[initialLanguage ?? 'en'].site;
---

<main class="universe" data-universe data-v4-initial-language={initialLanguage}>
	<header class="universe__header">
		<div class="universe__brand">
			<button class="universe__wordmark-spark" type="button" aria-label={initialSiteCopy.starSettings.open} aria-expanded="false" aria-controls="star-settings" data-wordmark-spark>✦</button>
			<a class="universe__wordmark" href="/" aria-label="Patrick Deniso home" data-wordmark>
			<span class="universe__wordmark-name" data-wordmark-name>Patrick Deniso</span>
			</a>
		</div>
		<div class="universe__star-settings" id="star-settings" role="dialog" aria-labelledby="star-settings-title" hidden data-star-settings>
			<div class="universe__star-settings-heading">
				<p id="star-settings-title" data-star-settings-title>{initialSiteCopy.starSettings.title}</p>
				<button type="button" aria-label={initialSiteCopy.starSettings.close} data-star-settings-close>×</button>
			</div>
			<label class="universe__star-slider">
				<span data-star-frequency-label>{initialSiteCopy.starSettings.frequency}</span>
				<strong data-star-frequency-value>{initialSiteCopy.starSettings.presets[2]}</strong>
				<input type="range" min="0" max="3" step="1" value="2" aria-valuetext={initialSiteCopy.starSettings.presets[2]} data-star-frequency />
			</label>
			<div class="universe__star-presets" aria-hidden="true">
				{initialSiteCopy.starSettings.presets.map((preset, index) => <span data-star-preset={index}>{preset}</span>)}
			</div>
		</div>
	</header>

	<section class="universe__scene" aria-label="Patrick Deniso's interactive universe" data-v4-scene>
		<h1 class="universe__sr-only" data-v4-page-title>{initialSiteCopy.title}</h1>
		<div class="universe__shooting-stars" aria-hidden="true" data-wordmark-stars></div>
		<UniverseExperience client:only="react" />

		<div class="universe__depth universe__console" aria-label="A code introduction" data-console>
			<div class="universe__console-bar">
				<div class="universe__console-controls" aria-label="Window controls">
					<button class="universe__console-control universe__console-control--close" type="button" aria-label="Close introduction" data-console-action="close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
					<button class="universe__console-control universe__console-control--minimize" type="button" aria-label="Minimize introduction" aria-pressed="false" data-console-action="minimize"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
					<button class="universe__console-control universe__console-control--maximize" type="button" aria-label="Maximize introduction" aria-pressed="false" data-console-action="maximize"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg></button>
				</div>
				<p>patrick.ts</p>
			</div>
			<div class="universe__console-code">
				<PatrickVimEditor client:only="react" />
			</div>
		</div>

	</section>

	<footer class="universe__footer">
		<div class="universe__utilities">
			<nav class="universe__contacts" aria-label="Contacts" data-v4-contacts>
				<a href="mailto:me@patrickdeniso.com" data-v4-contact="email">Email</a>
				<a href="https://www.instagram.com/patrick_deniso/" target="_blank" rel="noreferrer" data-v4-contact="instagram">Instagram</a>
				<div class="universe__wechat">
					<button class="universe__wechat-trigger" type="button" aria-expanded="false" aria-controls="wechat-contact-card" data-wechat-trigger data-v4-contact="wechat">WeChat</button>
					<div class="universe__wechat-card" id="wechat-contact-card" role="dialog" aria-label="WeChat QR code" hidden data-wechat-card>
						<img src="/contact/wechat-qr.jpg" alt="WeChat QR code for Patrick Deniso" data-wechat-image />
						<button class="universe__wechat-close" type="button" aria-label="Close WeChat QR code" data-wechat-close>×</button>
					</div>
				</div>
			</nav>
			<label class="universe__language">
				<span class="universe__sr-only" data-v4-language-label>Website language</span>
				<select class="v4-language-select" data-v4-language-picker aria-label="Website language">
					{supportedLanguages.map(({ code, label }) => <option value={code} selected={code === initialLanguage}>{label}</option>)}
				</select>
			</label>
		</div>
		<p class="universe__model-credit"><span data-v4-model-credit>3D models:</span> <a href="https://science.nasa.gov/3d-resources/">NASA / JPL-Caltech, NASA VTAD &amp; DigitalSpace Corporation</a></p>
		<div class="universe__version">
			<VersionPicker currentVersion={4} appearance="space" showLabel={false} />
		</div>
	</footer>

</main>

<script>
	import { copy, isV4Language } from '../../locales/v4';
	import { detectV4Language } from '../../locales/v4/detect';
	import { V4_CONSOLE_CLOSE_EVENT, V4_LANGUAGE_CHANGE_EVENT, V4_LANGUAGE_REQUEST_EVENT, V4_ROOM_CHANGE_EVENT, type V4LanguageRequestDetail, type V4RoomChangeDetail } from './v4Events';

	const universe = document.querySelector<HTMLElement>('[data-universe]');
	const consoleWindow = universe?.querySelector<HTMLElement>('[data-console]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const languagePickers = [...(universe?.querySelectorAll<HTMLSelectElement>('[data-v4-language-picker]') ?? [])];
	const wechatTrigger = universe?.querySelector<HTMLButtonElement>('[data-wechat-trigger]');
	const wechatCard = universe?.querySelector<HTMLElement>('[data-wechat-card]');
	const wechatClose = universe?.querySelector<HTMLButtonElement>('[data-wechat-close]');
	const wordmark = universe?.querySelector<HTMLAnchorElement>('[data-wordmark]');
	const wordmarkName = wordmark?.querySelector<HTMLElement>('[data-wordmark-name]');
	const wordmarkSpark = universe?.querySelector<HTMLButtonElement>('[data-wordmark-spark]');
	const shootingStars = universe?.querySelector<HTMLElement>('[data-wordmark-stars]');
	const starSettings = universe?.querySelector<HTMLElement>('[data-star-settings]');
	const starSettingsClose = universe?.querySelector<HTMLButtonElement>('[data-star-settings-close]');
	const starFrequency = universe?.querySelector<HTMLInputElement>('[data-star-frequency]');
	const starFrequencyValue = universe?.querySelector<HTMLElement>('[data-star-frequency-value]');
	const wordmarkLetters = [...'PatrickDeniso'];
	const wordmarkFonts = [
		'"Helvetica Neue", Helvetica, Arial, sans-serif',
		'Georgia, "Times New Roman", serif',
		'"American Typewriter", Rockwell, serif',
		'"Bradley Hand", "Marker Felt", cursive',
		'"Courier New", Courier, monospace',
		'Futura, "Trebuchet MS", sans-serif',
		'Baskerville, "Palatino Linotype", serif',
		'"Avenir Next", Avenir, sans-serif',
		'Copperplate, "Copperplate Gothic Light", fantasy',
		'ui-rounded, "Arial Rounded MT Bold", sans-serif',
	];
	let wordmarkScramble: number | undefined;
	let wordmarkIsScrambling = false;
	let wordmarkFontIndex = -1;
	let wordmarkTargetName = 'Patrick Deniso';
	const shuffleWordmark = () => {
		if (!wordmarkName) return;
		const shuffledName = [...wordmarkLetters];
		for (let index = shuffledName.length - 1; index > 0; index -= 1) {
			const swapIndex = Math.floor(Math.random() * (index + 1));
			[shuffledName[index], shuffledName[swapIndex]] = [shuffledName[swapIndex], shuffledName[index]];
		}
		wordmarkName.textContent = shuffledName.join('');
	};
	const resolveWordmark = () => {
		if (!wordmark || !wordmarkName || !wordmarkIsScrambling) return;
		window.clearInterval(wordmarkScramble);
		wordmarkName.textContent = wordmarkTargetName;
		wordmark.classList.remove('is-scrambling');
		wordmark.classList.add('has-custom-font');
		wordmarkFontIndex = (wordmarkFontIndex + 1) % wordmarkFonts.length;
		wordmarkName.style.setProperty('--wordmark-font', wordmarkFonts[wordmarkFontIndex]);
		wordmarkIsScrambling = false;
	};
	const scrambleWordmark = () => {
		if (!wordmark || !wordmarkName || wordmarkIsScrambling) return;
		wordmarkTargetName = Math.random() < 0.1 ? '潘德宇' : 'Patrick Deniso';
		wordmarkIsScrambling = true;
		if (reduceMotion) {
			resolveWordmark();
			return;
		}
		wordmark.classList.add('is-scrambling');
		shuffleWordmark();
		wordmarkScramble = window.setInterval(shuffleWordmark, 48);
	};
	wordmark?.addEventListener('pointerenter', scrambleWordmark);
	wordmark?.addEventListener('pointerleave', resolveWordmark);
	wordmark?.addEventListener('focus', scrambleWordmark);
	wordmark?.addEventListener('blur', resolveWordmark);

	let activeStarPresetLabels = copy.en.site.starSettings.presets;
	let shootingStarFrequency = 2;
	let shootingStarTimer: number | undefined;
	const starFrequencyStorageKey = 'v4-shooting-star-frequency';
	const shootingStarDelayRanges = [
		null,
		{ minimum: 8000, maximum: 20000 },
		{ minimum: 2000, maximum: 5000 },
		{ minimum: 1000, maximum: 1000 },
	] as const;
	const nextShootingStarDelay = () => {
		const range = shootingStarDelayRanges[shootingStarFrequency];
		return range ? range.minimum + Math.random() * (range.maximum - range.minimum) : null;
	};
	const emitShootingStar = () => {
		if (!wordmarkSpark || !shootingStars || document.visibilityState !== 'visible') return;
		const origin = wordmarkSpark.getBoundingClientRect();
		const angle = 18 + Math.random() * 48;
		const radians = angle * Math.PI / 180;
		const distance = Math.hypot(window.innerWidth, window.innerHeight) * (0.62 + Math.random() * 0.28);
		const shootingStar = document.createElement('span');
		shootingStar.className = 'universe__shooting-star';
		shootingStar.style.left = `${origin.left + origin.width / 2}px`;
		shootingStar.style.top = `${origin.top + origin.height / 2}px`;
		shootingStar.style.setProperty('--shooting-angle', `${angle}deg`);
		shootingStar.style.setProperty('--shooting-distance-x', `${Math.cos(radians) * distance}px`);
		shootingStar.style.setProperty('--shooting-distance-y', `${Math.sin(radians) * distance}px`);
		shootingStar.style.setProperty('--shooting-drift-x', `${-5 + Math.random() * 10}px`);
		shootingStar.style.setProperty('--shooting-drift-y', `${-4 + Math.random() * 8}px`);
		shootingStar.style.setProperty('--shooting-drift-x-2', `${-4 + Math.random() * 8}px`);
		shootingStar.style.setProperty('--shooting-drift-y-2', `${-3 + Math.random() * 6}px`);
		shootingStar.style.setProperty('--shooting-length', `${4.5 + Math.random() * 5.5}rem`);
		shootingStar.style.setProperty('--shooting-duration', `${1800 + Math.random() * 1000}ms`);
		shootingStars.append(shootingStar);
		shootingStar.addEventListener('animationend', () => shootingStar.remove(), { once: true });
	};
	const scheduleShootingStar = () => {
		window.clearTimeout(shootingStarTimer);
		const delay = nextShootingStarDelay();
		if (delay === null) {
			shootingStars?.replaceChildren();
			return;
		}
		shootingStarTimer = window.setTimeout(() => {
			emitShootingStar();
			scheduleShootingStar();
		}, delay);
	};
	const setShootingStarFrequency = (value: number, persist = true) => {
		shootingStarFrequency = Math.min(3, Math.max(0, Math.round(value)));
		if (starFrequency) {
			starFrequency.value = String(shootingStarFrequency);
			starFrequency.setAttribute('aria-valuetext', activeStarPresetLabels[shootingStarFrequency]);
		}
		starFrequencyValue?.replaceChildren(activeStarPresetLabels[shootingStarFrequency]);
		if (persist) window.sessionStorage.setItem(starFrequencyStorageKey, String(shootingStarFrequency));
		scheduleShootingStar();
	};
	const savedStarFrequency = Number.parseInt(window.sessionStorage.getItem(starFrequencyStorageKey) ?? '', 10);
	setShootingStarFrequency(Number.isInteger(savedStarFrequency) ? savedStarFrequency : reduceMotion ? 0 : 2, false);
	starFrequency?.addEventListener('input', () => setShootingStarFrequency(starFrequency.valueAsNumber));

	const closeStarSettings = () => {
		if (!starSettings || starSettings.hidden) return;
		starSettings.hidden = true;
		wordmarkSpark?.setAttribute('aria-expanded', 'false');
	};
	wordmarkSpark?.addEventListener('click', () => {
		if (!starSettings) return;
		const isOpening = starSettings.hidden;
		starSettings.hidden = !isOpening;
		wordmarkSpark.setAttribute('aria-expanded', String(isOpening));
	});
	starSettingsClose?.addEventListener('click', () => {
		closeStarSettings();
		wordmarkSpark?.focus();
	});
	const setLanguage = (language: string) => {
		const nextLanguage = isV4Language(language) ? language : 'en';
		document.documentElement.dataset.v4Language = nextLanguage;
		document.documentElement.lang = nextLanguage;
		languagePickers.forEach((picker) => { picker.value = nextLanguage; });
		const text = copy[nextLanguage].site;
		document.title = text.title;
		document.querySelector('meta[name="description"]')?.setAttribute('content', text.description);
		universe?.querySelector<HTMLElement>('[data-v4-page-title]')?.replaceChildren(text.title);
		universe?.querySelector<HTMLElement>('[data-v4-scene]')?.setAttribute('aria-label', text.sceneLabel);
		consoleWindow?.setAttribute('aria-label', text.codeIntroduction);
		consoleWindow?.querySelector<HTMLElement>('.universe__console-controls')?.setAttribute('aria-label', text.windowControls);
		consoleWindow?.querySelector<HTMLButtonElement>('[data-console-action="close"]')?.setAttribute('aria-label', text.close);
		consoleWindow?.querySelector<HTMLButtonElement>('[data-console-action="minimize"]')?.setAttribute('aria-label', text.minimize);
		consoleWindow?.querySelector<HTMLButtonElement>('[data-console-action="maximize"]')?.setAttribute('aria-label', text.maximize);
		universe?.querySelector<HTMLElement>('[data-v4-contacts]')?.setAttribute('aria-label', text.contacts);
		universe?.querySelectorAll<HTMLElement>('[data-v4-contact]').forEach((contact) => {
			const key = contact.dataset.v4Contact as 'email' | 'instagram' | 'wechat';
			contact.replaceChildren(text[key]);
		});
		universe?.querySelectorAll<HTMLElement>('[data-v4-language-label]').forEach((label) => label.replaceChildren(text.websiteLanguage));
		languagePickers.forEach((picker) => picker.setAttribute('aria-label', text.websiteLanguage));
		universe?.querySelector<HTMLElement>('[data-v4-model-credit]')?.replaceChildren(text.modelCredit);
		universe?.querySelector<HTMLSelectElement>('.version-picker__select')?.setAttribute('aria-label', text.websiteVersion);
		wechatCard?.setAttribute('aria-label', text.wechatQrCode);
		universe?.querySelector<HTMLImageElement>('[data-wechat-image]')?.setAttribute('alt', text.wechatQrCode);
		wechatClose?.setAttribute('aria-label', text.close);
		activeStarPresetLabels = text.starSettings.presets;
		wordmarkSpark?.setAttribute('aria-label', text.starSettings.open);
		starSettingsClose?.setAttribute('aria-label', text.starSettings.close);
		universe?.querySelector<HTMLElement>('[data-star-settings-title]')?.replaceChildren(text.starSettings.title);
		universe?.querySelector<HTMLElement>('[data-star-frequency-label]')?.replaceChildren(text.starSettings.frequency);
		universe?.querySelectorAll<HTMLElement>('[data-star-preset]').forEach((preset, index) => preset.replaceChildren(text.starSettings.presets[index]));
		starFrequency?.setAttribute('aria-label', text.starSettings.frequency);
		starFrequency?.setAttribute('aria-valuetext', activeStarPresetLabels[shootingStarFrequency]);
		starFrequencyValue?.replaceChildren(activeStarPresetLabels[shootingStarFrequency]);
		window.dispatchEvent(new Event(V4_LANGUAGE_CHANGE_EVENT));
	};

	const chooseLanguage = (language: string, updateUrl = true) => {
		if (!isV4Language(language)) return;
		window.localStorage.setItem('v4-language', language);
		if (updateUrl) {
			const nextPath = `/v/4/${language}/`;
			if (window.location.pathname !== nextPath) window.history.pushState(null, '', nextPath);
		}
		setLanguage(language);
	};

	void detectV4Language(universe?.dataset.v4InitialLanguage).then((language) => {
		setLanguage(language);
		if (!window.location.pathname.match(/^\/v\/4\/(en|it|fr|zh)\/?$/)) {
			window.history.replaceState(null, '', `/v/4/${language}/`);
		}
	});
	languagePickers.forEach((picker) => picker.addEventListener('change', () => chooseLanguage(picker.value)));
	window.addEventListener(V4_LANGUAGE_REQUEST_EVENT, (event) => {
		if (event instanceof CustomEvent) chooseLanguage((event.detail as V4LanguageRequestDetail).language);
	});
	window.addEventListener('popstate', () => {
		const routedLanguage = window.location.pathname.match(/^\/v\/4\/(en|it|fr|zh)\/?$/)?.[1];
		if (isV4Language(routedLanguage)) setLanguage(routedLanguage);
		else void detectV4Language().then(setLanguage);
	});

	const closeWechatCard = () => {
		if (!wechatCard || wechatCard.hidden) return;
		wechatCard.hidden = true;
		wechatTrigger?.setAttribute('aria-expanded', 'false');
	};

	wechatTrigger?.addEventListener('click', () => {
		if (!wechatCard) return;
		const isOpening = wechatCard.hidden;
		wechatCard.hidden = !isOpening;
		wechatTrigger.setAttribute('aria-expanded', String(isOpening));
	});
	wechatClose?.addEventListener('click', closeWechatCard);
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node)) return;
		if (wechatCard && !wechatCard.hidden && !wechatCard.contains(event.target) && !wechatTrigger?.contains(event.target)) closeWechatCard();
		if (starSettings && !starSettings.hidden && !starSettings.contains(event.target) && !wordmarkSpark?.contains(event.target)) closeStarSettings();
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			closeWechatCard();
			closeStarSettings();
		}
	});

	consoleWindow?.querySelectorAll<HTMLButtonElement>('[data-console-action]').forEach((control) => {
		control.addEventListener('click', () => {
			const action = control.dataset.consoleAction;
			if (action === 'close') {
				consoleWindow.classList.add('is-closed');
				universe?.classList.remove('has-maximized-console');
				return;
			}

			const stateClass = action === 'minimize' ? 'is-minimized' : 'is-maximized';
			const alternateStateClass = action === 'minimize' ? 'is-maximized' : 'is-minimized';
			const isActive = consoleWindow.classList.toggle(stateClass);
			consoleWindow.classList.remove(alternateStateClass);
			universe?.classList.toggle('has-maximized-console', action === 'maximize' && isActive);
			control.setAttribute('aria-pressed', String(isActive));
			consoleWindow.querySelector<HTMLButtonElement>(`[data-console-action="${action === 'minimize' ? 'maximize' : 'minimize'}"]`)?.setAttribute('aria-pressed', 'false');
		});
	});
	window.addEventListener(V4_CONSOLE_CLOSE_EVENT, () => {
		consoleWindow?.classList.add('is-closed');
		universe?.classList.remove('has-maximized-console');
	});

	window.addEventListener(V4_ROOM_CHANGE_EVENT, (event) => {
		const roomIsOpen = event instanceof CustomEvent && (event.detail as V4RoomChangeDetail).open;
		consoleWindow?.classList.toggle('is-room-hidden', roomIsOpen);
	});

	if (universe && !reduceMotion && !window.matchMedia('(pointer: coarse)').matches) {
		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let frame: number | undefined;

		const render = () => {
			currentX += (targetX - currentX) * 0.08;
			currentY += (targetY - currentY) * 0.08;
			universe.style.setProperty('--pointer-x', currentX.toFixed(3));
			universe.style.setProperty('--pointer-y', currentY.toFixed(3));
			if (Math.abs(targetX - currentX) > 0.002 || Math.abs(targetY - currentY) > 0.002) {
				frame = window.requestAnimationFrame(render);
			} else {
				frame = undefined;
			}
		};

		const updatePointer = (event: PointerEvent) => {
			const bounds = universe.getBoundingClientRect();
			targetX = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
			targetY = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
			if (!frame) frame = window.requestAnimationFrame(render);
		};

		universe.addEventListener('pointermove', updatePointer);
		universe.addEventListener('pointerleave', () => {
			targetX = 0;
			targetY = 0;
			if (!frame) frame = window.requestAnimationFrame(render);
		});
	}
</script>

<style>
	:global(html) { background: #050617; }
	:global(body) { margin: 0; min-width: 320px; background: #050617; }
	:global(*) { box-sizing: border-box; }

	.universe {
		--pointer-x: 0;
		--pointer-y: 0;
		--v4-utility-border: rgb(176 180 255 / .2);
		--v4-utility-background: rgb(13 15 48 / .36);
		--v4-utility-color: rgb(202 204 242 / .72);
		--v4-utility-hover: rgb(133 145 255 / .17);
		--v4-utility-radius: .52rem;
		--v4-utility-height: 2rem;
		position: relative;
		isolation: isolate;
		display: flex;
		min-height: 100svh;
		flex-direction: column;
		overflow: hidden;
		padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1.25rem, 5vw, 5rem) 1.5rem;
		background: #050617;
		color: #f8f7ff;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}


	.universe__header, .universe__footer, .universe__scene { position: relative; z-index: 1; width: min(1220px, 100%); margin-inline: auto; }
	.universe__header { z-index: 8; display: flex; align-items: center; gap: 1rem; }
	.universe__brand { display: inline-flex; align-items: center; gap: .38rem; }
	.universe__wordmark { display: inline-flex; align-items: center; color: #f8f7ff; font: 400 clamp(.78rem, 1.6vw, .93rem)/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: -.05em; text-decoration: none; }
	.universe__wordmark-spark { position: relative; z-index: 1; display: grid; width: 1.25rem; height: 1.25rem; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #f5d979; cursor: pointer; font: 400 1rem/1 ui-monospace, monospace; transition: color 160ms ease, filter 160ms ease, transform 220ms cubic-bezier(.22, 1, .36, 1); }
	.universe__wordmark-spark::after { position: absolute; z-index: -1; inset: -.12rem; border: 1px solid rgb(238 241 255 / .7); border-radius: 50%; content: ''; opacity: 0; transform: scale(.5); transition: opacity 160ms ease, transform 220ms cubic-bezier(.22, 1, .36, 1); }
	.universe__wordmark-spark:hover, .universe__wordmark-spark:focus-visible, .universe__wordmark-spark[aria-expanded="true"] { color: #fff; filter: drop-shadow(0 0 .42rem rgb(200 210 255 / .95)); outline: none; transform: scale(1.38); }
	.universe__wordmark-spark:hover::after, .universe__wordmark-spark:focus-visible::after, .universe__wordmark-spark[aria-expanded="true"]::after { opacity: 1; transform: scale(1); }
