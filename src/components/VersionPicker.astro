---
interface Props {
	currentVersion: 1 | 2 | 3 | 4;
	appearance?: 'default' | 'legacy' | 'space';
	showLabel?: boolean;
}

const { currentVersion, appearance = 'default', showLabel = true } = Astro.props;

const versions = [
	{ number: 1, label: 'v1 · 2022', href: '/v/1/' },
	{ number: 2, label: 'v2 · 2023', href: '/v/2/' },
	{ number: 3, label: 'v3 · 2024', href: '/v/3/' },
	{ number: 4, label: 'v4 · latest', href: '/v/4/' },
] as const;
---

<label class:list={['version-picker', `version-picker--${appearance}`]}>
	{showLabel ? <span class="version-picker__label">Website version</span> : null}
	<select class="version-picker__select" aria-label="Website version">
		{versions.map((version) => (
			<option value={version.href} selected={version.number === currentVersion}>
				{version.label}
			</option>
		))}
	</select>
</label>

<script>
	document.querySelectorAll<HTMLSelectElement>('.version-picker__select').forEach((picker) => {
		picker.addEventListener('change', () => window.location.assign(picker.value));
	});
</script>

<style>
	.version-picker {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.01em;
	}

	.version-picker__label {
		color: rgb(115 115 115);
	}

	.version-picker__select {
		cursor: pointer;
		border: 1px solid rgb(163 163 163 / 0.65);
		border-radius: 0.375rem;
		background: rgb(255 255 255 / 0.9);
		padding: 0.25rem 1.6rem 0.25rem 0.5rem;
		color: rgb(38 38 38);
		font: inherit;
	}

	:global(.dark) .version-picker__label {
		color: rgb(163 163 163);
	}

	:global(.dark) .version-picker__select {
		border-color: rgb(115 115 115 / 0.8);
		background: rgb(0 9 29 / 0.9);
		color: rgb(245 245 245);
	}

	.version-picker--space .version-picker__label {
		color: rgb(202 204 242 / 0.72);
	}

	.version-picker--space .version-picker__select {
		height: var(--v4-utility-height, 2rem);
		border-color: var(--v4-utility-border, rgb(176 180 255 / .2));
		border-radius: var(--v4-utility-radius, .52rem);
		background-color: var(--v4-utility-background, rgb(13 15 48 / .36));
		box-shadow: inset 0 1px 0 rgb(255 255 255 / .04);
		padding: .22rem 1.5rem .22rem .55rem;
		color: var(--v4-utility-color, rgb(202 204 242 / .72));
		font: 700 clamp(.58rem, .75vw, .66rem)/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}

	.version-picker--space .version-picker__select:hover,
	.version-picker--space .version-picker__select:focus-visible {
		border-color: var(--v4-utility-border, rgb(176 180 255 / .2));
		background-color: var(--v4-utility-hover, rgb(133 145 255 / .17));
		color: #fff;
		outline: 1px solid rgb(255 255 255 / .42);
		outline-offset: 1px;
	}
</style>
