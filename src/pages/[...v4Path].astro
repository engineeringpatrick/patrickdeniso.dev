---
import UniverseHome from '../components/v4/UniverseHome.astro';
import ProfileSeo from '../components/v4/ProfileSeo.astro';
import { v4Path } from '../components/v4/v4Routes';
import { v4StaticTargets, v4TargetPath } from '../components/v4/v4StaticRoutes';
import { supportedLanguages, type V4Language } from '../locales/v4';

export function getStaticPaths() {
	return supportedLanguages.flatMap(({ code: language }) => {
		const routes = v4StaticTargets.map((target) => ({ path: v4TargetPath(language, target), language }));
		if (language !== 'en') routes.unshift({ path: v4Path(language), language });
		const pages = routes.map(({ path, language }) => ({ params: { v4Path: path.slice(1, -1) }, props: { language } }));
		const oldCommentsPath = language === 'en' ? '/comments/' : `/${language}/comments/`;
		return [...pages, {
			params: { v4Path: oldCommentsPath.slice(1, -1) },
			props: { language, redirectTo: v4Path(language, 'comments') },
		}];
	});
}

interface Props {
	language: V4Language;
	redirectTo?: string;
}

const { language, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
const indexable = Astro.url.pathname === v4Path(language);
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#050617" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<ProfileSeo language={language} canonicalPath={Astro.url.pathname} indexable={indexable} />
	</head>
	<body>
		<UniverseHome initialLanguage={language} />
	</body>
</html>
