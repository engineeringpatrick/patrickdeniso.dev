---
import { supportedLanguages } from '../../../locales/v4';
import { v4Path } from '../../../components/v4/v4Routes';

export function getStaticPaths() {
	return supportedLanguages.map(({ code: language }) => ({
		params: { language },
		props: { target: v4Path(language) },
	}));
}

return Astro.redirect((Astro.props as { target: string }).target, 301);
---
