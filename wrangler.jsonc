{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": "dist/_worker.js/index.js",
	"name": "dev-patrickdeniso-dev2-0",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "patrickdeniso.com/api/v4-comments*",
			"zone_name": "patrickdeniso.com"
		}
	],
	"compatibility_date": "2025-12-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "COMMENTS_DB",
			"database_name": "patrickdeniso-comments",
			"database_id": "24391d6f-5d1c-4654-87f9-830238c6492c",
			"migrations_dir": "migrations"
		}
	]
}
